  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./deadlines.yaml": "./deadlines.yaml"
  },
  "bin": {
    "infra-deadlines": "./bin/infra-deadlines.mjs"
  },
  "files": [
    "src",
